generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSalesRequest {
  id             String   @id @default(cuid())
  fullName       String
  workEmail      String
  phone          String?
  plan           String?
  country        String?
  companyWebsite String?
  companyName    String
  message        String?
  createdAt      DateTime @default(now())

  @@map("contact_sales_requests")
}

model ChatLead {
  id        Int           @id @default(autoincrement())
  name      String
  contact   String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  @@map("chat_leads")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      ChatLead @relation(fields: [leadId], references: [id])
  role      String  
  content   String
  createdAt DateTime @default(now())
  @@map("chat_messages")
}