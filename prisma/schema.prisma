generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSalesRequest {
  id             String   @id @default(cuid())
  fullName       String
  workEmail      String
  phone          String?
  plan           String?
  country        String?
  companyWebsite String?
  companyName    String
  message        String?
  createdAt      DateTime @default(now())

  @@map("contact_sales_requests")
}